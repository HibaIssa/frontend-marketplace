# LOCAL DEV: If you changed marketplace/src (API) code, the hosted Cloud Run backend does NOT pick it up.
# Either redeploy the API, or point this app at your local API:
# NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Frontend only (recommended) ─────────────────────────────────────────────
# Run ONLY from this folder:  pnpm dev
# Do NOT run `pnpm dev` at the repo root unless you need the local API + Postgres.
#
# Use the hosted API (already the default in src/lib/api/client.ts if this is unset):
# NEXT_PUBLIC_API_URL=https://marketplace-96918972071.asia-southeast1.run.app
#
# Or delete/comment NEXT_PUBLIC_API_URL entirely — same default applies.

# Admin catalog URL — browser + server proxies derive origin from this:
# `/api/dashboard/*`, `/api/catalog-backend/*`, catalog mirror (see adminApiOrigin.ts).
# NEXT_PUBLIC_ADMIN_DASHBOARD_API_URL=https://marketplace-app-96918972071.asia-southeast1.run.app/admin/catalog

# Fashion REST used by `/api/catalog-backend/products/*` when NEXT_PUBLIC_API_URL differs from admin deploy.
# FASHION_API_UPSTREAM_ORIGIN=https://marketplace-app-96918972071.asia-southeast1.run.app

# Local dev: open catalog admin in the browser on Cloud Run (address bar + nav), not localhost.
# NEXT_PUBLIC_HOSTED_ADMIN_CATALOG_NAV=1

# Cloud Run / no database: catalog admin uses only the Fashion API (no Supabase).
# CATALOG_ADMIN_BACKEND_ONLY=1

# Local dev: proxy /api/admin/* and /api/catalog/* to deployed Bolden so UI matches production.
# CATALOG_MIRROR_ORIGIN=https://marketplace-app-96918972071.asia-southeast1.run.app

# ── Optional: Supabase (full admin KPIs / freshness / prices from DB) ──
# Without these, overview + vendors use GET /products/facets via /api/catalog-backend (same deploy);
# freshness + prices admin routes return empty until Supabase is configured.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Full local stack (Next + API on your PC; needs repo root .env + DATABASE_URL) ──
# NEXT_PUBLIC_API_URL=http://localhost:4000

# ── If port 3001 is busy ──
# pnpm dev:3010   →  http://localhost:3010
